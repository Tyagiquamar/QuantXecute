# Local development against docker compose (replay demo):
NEXT_PUBLIC_ENGINE_HTTP_URL=http://localhost:8080
NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:8080

# Production (Vercel) example - set these in the Vercel project settings:
# NEXT_PUBLIC_ENGINE_HTTP_URL=https://<engine-host>
# NEXT_PUBLIC_ENGINE_WS_URL=wss://<engine-host>