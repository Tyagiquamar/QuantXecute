# QuantXecute engine - production environment contract
# Copy to the host (or paste into your platform's env editor) and fill in
# <dashboard-domain>. PORT is normally injected by the hosting platform;
# only set it explicitly on a plain Docker host.

QX_MODE=live
QX_EXCHANGE=okx
QX_INSTRUMENT=BTC-USDT
QX_CHANNEL=books
QX_OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
QX_ALLOWED_ORIGINS=https://<dashboard-domain>
# PORT=8080
# QX_CA_CERT_PATH=
# QX_STALENESS_MS=5000
